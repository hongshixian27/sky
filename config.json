{
  "log": {
    "level": "error"
  },
  "inbounds": [
    {
      "type": "vless",
      "tag": "vless-in",
      "listen": "127.0.0.1",
      "listen_port": 8081,
      "users": [
        {
          "uuid": "00000000-0000-0000-0000-000000000000"
        }
      ],
      "transport": {
        "type": "ws",
        "path": "/blog"
      }
    }
  ],
  "outbounds": [
    {
      "type": "http",
      "tag": "cn-fallback",
      "server": "127.0.0.1",
      "server_port": 18082
    },
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "rules": [
      { "network": "udp", "outbound": "direct" },
      { "ip_is_private": true, "outbound": "direct" },
      { "domain_suffix": ["local", "lan", "ts.net"], "outbound": "direct" },
      { "domain_suffix": ["cn", "douyin.com", "douyincdn.com", "douyinpic.com", "douyinvod.com", "amemv.com", "snssdk.com", "toutiao.com", "byteimg.com", "bytecdn.cn", "bytedance.com", "bilibili.com", "biliapi.net", "biliapi.com", "bilivideo.com", "bilivideo.cn", "hdslb.com", "b23.tv", "163.com", "126.com", "netease.com", "music.126.net", "127.net", "qq.com", "qpic.cn", "qlogo.cn", "gtimg.com", "tencent.com", "weixin.com", "wechat.com", "weixin.qq.com", "tenpay.com", "myqcloud.com", "kuaishou.com", "gifshow.com", "kwai.com", "yximgs.com", "ksyuncdn.com", "weibo.com", "weibo.cn", "sina.com.cn", "xiaohongshu.com", "xhscdn.com", "zhihu.com", "zhimg.com", "baidu.com", "bdstatic.com", "bdimg.com", "icbc.com.cn", "ccb.com", "boc.cn", "abchina.com", "bankcomm.com", "cmbchina.com", "cmbc.com.cn", "cebbank.com", "cib.com.cn", "spdb.com.cn", "psbc.com", "pingan.com", "bank.ecitic.com", "alipay.com"], "outbound": "cn-fallback" },
      { "rule_set": ["geosite-cn", "geoip-cn"], "outbound": "cn-fallback" }
    ],
    "rule_set": [
      { "type": "local", "tag": "geosite-cn", "format": "binary", "path": "/app/geosite-cn.srs" },
      { "type": "local", "tag": "geoip-cn", "format": "binary", "path": "/app/geoip-cn.srs" }
    ],
    "final": "direct"
  }
}
